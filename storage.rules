rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSeller() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['seller', 'admin'];
    }

    function isProductOwner(productId) {
      return isAuthenticated() && 
        get(/databases/(default)/documents/products/$(productId)).data.sellerId == request.auth.uid;
    }

    function isDisputeParty(disputeId) {
      return isAuthenticated() && 
        (get(/databases/(default)/documents/disputes/$(disputeId)).data.filedBy == request.auth.uid || isAdmin());
    }

    // User avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && request.resource.size < 5 * 1024 * 1024;
    }

    // Product images
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isProductOwner(productId) && request.resource.size < 10 * 1024 * 1024;
    }

    // Verification documents
    match /verifications/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024;
    }

    // Dispute evidence
    match /disputes/{disputeId}/{allPaths=**} {
      allow read: if isDisputeParty(disputeId);
      allow write: if isDisputeParty(disputeId) && request.resource.size < 10 * 1024 * 1024;
    }

    // Inspection images
    match /inspections/{inspectionId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
