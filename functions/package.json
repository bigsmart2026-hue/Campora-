{
  "name": "campora-functions",
  "description": "Cloud Functions for Campora",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^11.10.0",
    "firebase-functions": "^4.5.0",
    "firebase-functions-debug": "^1.1.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/node": "^18.18.0",
    "typescript": "^5.2.2"
  },
  "private": true
}
